# Copy to services/api/.env (git-ignored). The public API holds NO database credentials.
API_PORT=4000
# Internal address of services/market-catalog.
MARKET_CATALOG_URL=http://127.0.0.1:4100
MARKET_CATALOG_TIMEOUT_MS=5000

# Internal address of services/trading (accounts and the cash ledger).
TRADING_URL=http://127.0.0.1:4200
TRADING_TIMEOUT_MS=5000

# Supabase Auth, used only to verify the access token a signed-in browser session carries.
# Both values are PUBLIC (dashboard -> Project Settings -> API Keys: Project URL + Publishable key).
# Never put the secret or service_role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
