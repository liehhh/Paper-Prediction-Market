{
  "name": "@league/api",
  "private": true,
  "type": "module",
  "description": "Public, client-facing HTTP API. Holds no database credentials.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@league/catalog-contract": "workspace:*",
    "@league/trading-contract": "workspace:*",
    "express": "5.3.0",
    "sharp": "0.34.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6"
  }
}
