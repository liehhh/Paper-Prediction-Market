# Copy to services/trading/.env (git-ignored) and fill in.
# This service owns the `trading` schema. Like market-catalog, it is a database-credential holder;
# services/api and apps/web never receive DATABASE_URL.

# Supabase dashboard -> your project -> "Connect" -> Shared pooler (session mode, port 5432).
# Replace [YOUR-DATABASE-PASSWORD]; percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-DATABASE-PASSWORD]@your-region.pooler.supabase.com:5432/postgres

# Path to the CA certificate from Supabase dashboard -> Project Settings -> Database -> SSL Configuration.
# When set, the server certificate is verified.
DATABASE_CA_CERT_PATH=

# Internal HTTP interface. Bound to loopback; only services/api should call it.
TRADING_HOST=127.0.0.1
TRADING_PORT=4200
