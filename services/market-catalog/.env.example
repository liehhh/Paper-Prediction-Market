# Copy to services/market-catalog/.env (git-ignored) and fill in.
# This is the ONLY service that receives database credentials.

# Supabase dashboard -> your project -> "Connect" -> Shared pooler (session mode, port 5432).
# Replace [YOUR-DATABASE-PASSWORD]; percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-DATABASE-PASSWORD]@your-region.pooler.supabase.com:5432/postgres

# Optional but recommended: path to the CA certificate downloaded from
# Supabase dashboard -> Project Settings -> Database -> SSL Configuration.
# When set, the server certificate is verified. When empty, the connection is
# still encrypted, but the certificate is not verified (a warning is logged).
DATABASE_CA_CERT_PATH=

# Internal HTTP interface. Bound to loopback; only services/api should call it.
CATALOG_HOST=127.0.0.1
CATALOG_PORT=4100

# Polymarket Gamma API (public, no key required).
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
# Per-run limit: pages of 100 events fetched per Polymarket tag. If a tag has more
# pages than this, the run is recorded as 'partial' and nothing is delisted.
SYNC_MAX_PAGES_PER_TAG=40
SYNC_REQUEST_TIMEOUT_MS=30000
SYNC_MAX_ATTEMPTS_PER_REQUEST=4
