{
  "name": "@league/market-catalog",
  "private": true,
  "type": "module",
  "description": "Owns Polymarket integration, normalization, and the market_catalog schema.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "sync": "node --env-file-if-exists=.env src/sync-cli.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/apply-migrations.ts",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@league/catalog-contract": "workspace:*",
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "embedded-postgres": "17.11.0-beta.19",
    "supabase": "3.2.0"
  }
}
