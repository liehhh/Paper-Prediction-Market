{
  "name": "paper-prediction-league",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --stream run dev",
    "db:migrate": "pnpm --filter @league/market-catalog run db:migrate",
    "catalog:sync": "pnpm --filter @league/market-catalog run sync",
    "lint": "eslint . && pnpm --filter @league/web run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "test:live": "pnpm --filter @league/market-catalog run test:live",
    "build": "pnpm run typecheck && pnpm --filter @league/web run build",
    "start": "pnpm --recursive --parallel --stream run start"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "globals": "16.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
