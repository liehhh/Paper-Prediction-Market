# Copy to apps/web/.env.local (git-ignored).
# Server-side only (no NEXT_PUBLIC_ prefix): pages call the public API from the Next.js server.
API_BASE_URL=http://localhost:4000

# Supabase Auth for sign-in / registration / session cookies. Both values are PUBLIC
# (dashboard -> Project Settings -> API Keys: Project URL + Publishable key). Server-side only here.
# Never put the secret or service_role key in this file.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
